# ── LLM API Keys ──
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Google Gemini. Each Google Cloud PROJECT has its own free 20-req/day quota, so listing
# several project keys multiplies the daily budget — the router rotates to the next project
# when one hits its daily quota.
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_API_KEYS=AIza_project1,AIza_project2,AIza_project3
# Optional: xAI Grok key (used when LLM_PROVIDER=xai). Get one at https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Groq free-tier key (used when LLM_PROVIDER=groq). Free at https://console.groq.com
# Multi-key rotation: comma-separate several keys (here or in GROQ_API_KEYS) to multiply the
# free daily token budget — the router rotates to the next key on rate-limit/quota errors.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Optional: Cerebras free-tier key (fast, generous free daily budget). Free at https://cloud.cerebras.ai
# Tried as a backup after the primary; comma-separate several keys to rotate.
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CEREBRAS_API_KEYS=csk_key1,csk_key2

# ── Model Configuration ──
# Primary LLM provider for ALL features: openrouter | gemini | groq | cerebras | xai
# Chain: primary → groq → cerebras → xai → Gemini (multi-project) → OpenRouter
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen-2.5-72b-instruct       # primary OpenRouter model (all features)
# Per-feature OpenRouter model overrides (default = LLM_MODEL). e.g.:
# OPENROUTER_MODEL_SUMMARIZE=qwen/qwen-2.5-72b-instruct
# OPENROUTER_MODEL_DEFENSE=qwen/qwen-2.5-72b-instruct
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.1-fast                     # verify exact id via GET /v1/models
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile          # default model (QA/chat/summarize)
GROQ_MODEL_STRONG=llama-3.3-70b-versatile   # heavy reasoning (defense memo, weakness analysis)
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b                 # verify exact id at cloud.cerebras.ai

# ── Agentic memo self-check (draft -> verify against context -> revise) ──
MEMO_SELF_CHECK=True              # set False to skip the extra revision pass (saves tokens)
MEMO_SELF_CHECK_MAX_ITERS=1       # revision passes per memo
# ── Embeddings ──
# Default: local BGE-M3 (1024-dim) on CPU — strong multilingual/Arabic retrieval and long-chunk
# support. MiniLM-384 is faster to rebuild but markedly weaker on Arabic legal text; it is the
# weakest link in retrieval quality, so prefer bge-m3 unless rebuild time is prohibitive.
# Switching the model/dimension REQUIRES a full index rebuild (vectors are incompatible).
EMBED_MODEL=BAAI/bge-m3
EMBED_DIMENSIONS=1024                       # 1024 for bge-m3; 384 for paraphrase-multilingual-MiniLM-L12-v2
EMBED_MAX_SEQ_LENGTH=1024                   # bge-m3 supports 8192; 1024 bounds CPU attention memory
EMBED_BATCH_SIZE=8                          # CPU: 8 keeps bge-m3 attention under ~3 GB on long chunks
EMBED_PROVIDER=local                       # local | google | openrouter
# Cap Gemini 2.5 Flash hidden thinking tokens (prevents answer truncation). 0 disables thinking.
GEMINI_THINKING_BUDGET=512
# Retry transient Gemini 503/429 failures per model tier with exponential backoff
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY=2.0
# Minimum seconds between physical LLM provider requests (in-process rate gate). Spaces out
# the draft→retry→rescue pattern + concurrent users so free-tier per-minute limits don't 413.
# 0 disables. Raise it if you still hit rate limits; lower it on paid tiers.
LLM_MIN_INTERVAL_S=2.0

# ── Reranker ──
USE_RERANKER=True
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Cross-encoder reranks the top-N RRF candidates → final top-k. Wider N lets the reranker
# rescue a relevant chunk that RRF ranked low; too narrow (e.g. 10) hides most of the corpus.
# On CPU this is the dominant per-query latency knob (~1.5s/candidate).
RETRIEVAL_K_RERANK=20
# Max concurrent cross-encoder reranks (rerank is CPU-bound; cap so concurrent heavy
# requests queue instead of thrashing the CPU into timeouts).
RERANK_MAX_CONCURRENCY=2
# Lift the (low) Arabic reranker sigmoid so grounded answers don't read as low-confidence.
# <1 raises mid-range scores; 1.0 = off. Re-validate against your eval set if you change it.
RERANK_CALIBRATION_GAMMA=0.5

# ── Answer cache (free-tier budget saver; stateless /qa only) ──
USE_ANSWER_CACHE=True
ANSWER_CACHE_MAX=512                        # max cached questions (LRU eviction)
ANSWER_CACHE_PERSIST=True                   # survive restarts — pre-warm a demo, then it's free
ANSWER_CACHE_PATH=./data/answer_cache.json  # clear this file after rebuilding the index

# ── Session Management ──
SESSION_PERSIST=True                       # persist chat sessions to disk (survives restart)
SESSION_PERSIST_DIR=./data/sessions
SESSION_MAX_TURNS=6                        # compact older turns when conversation exceeds this many user turns
SESSION_KEEP_RECENT=3                      # keep last N turns verbatim after compaction
SESSION_TTL_HOURS=168                      # 7 days; idle sessions older than this are pruned

# ── Ingest Automation ──
INGEST_INBOX_DIR=./data/inbox              # drop new legal docs here for the watch-folder ingester
INGEST_WATCH_INTERVAL_S=30                 # scripts/watch_ingest.py polls every N seconds

# ── Benchmark (compare our system vs. OpenAI/Claude via OpenRouter) ──
BENCHMARK_OPENAI_MODEL=openai/gpt-4o-mini
BENCHMARK_CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# ── Data Paths ──
DATASET_DIR=./data/legal_docs
DATA_DIR=./data

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Context / Output budgets ──
MAX_CONTEXT_CHARS=12000                     # retrieved-context cap per prompt (relaxed for OpenRouter's large window)
LLM_MAX_TOKENS_QA=2048                      # output cap for short-answer features (qa/chat)

# ── Corrective cascade (qa/chat) ──
ITERATIVE_K_SEQUENCE=10,18                  # widen-k retries on ungrounded citations (one expansion)
RETRY_MAX_ATTEMPTS=1                        # corrective LLM retries
QA_CASCADE_BUDGET_S=90                      # wall-clock budget for the corrective cascade; 0 disables

# ── Agentic pipeline (/weakness, /defense) ──
# Document Analysis → Weakness Detection → Legal Research → Precedent Retrieval → Strategy → Memo.
# Falls back to single-shot automatically if any agent fails.
USE_AGENTIC_PIPELINE=True
AGENT_MAX_WEAKNESSES=6                      # weaknesses given deep research (1 retrieval each)
AGENT_RESEARCH_K=6                          # chunks retrieved per weakness (doctrine + precedents)
AGENT_PRECEDENT_DOC_TYPES=cassation,naqd,نقض,criminal_case,ruling   # doc_type markers labeled as precedents
AGENT_ANALYSIS_MAX_TOKENS=2048
AGENT_DETECT_MAX_TOKENS=2048
AGENT_STRATEGY_MAX_TOKENS=2048
AGENT_SYNTH_MAX_TOKENS=4096
