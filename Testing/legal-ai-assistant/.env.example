# ── LLM API Keys ──
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Google Gemini API key (primary LLM provider; falls back to OpenRouter if unset)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: xAI Grok key (used when LLM_PROVIDER=xai). Get one at https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Groq free-tier key (used when LLM_PROVIDER=groq). Free at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model Configuration ──
# Primary LLM provider: gemini | xai | groq
LLM_PROVIDER=gemini
LLM_MODEL=qwen/qwen-2.5-72b-instruct       # OpenRouter fallback model
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.1-fast                     # verify exact id via GET /v1/models
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile          # verify exact id via GET /models
EMBED_MODEL=BAAI/bge-m3
EMBED_PROVIDER=local                       # local | google | openrouter
# Cap Gemini 2.5 Flash hidden thinking tokens (prevents answer truncation). 0 disables thinking.
GEMINI_THINKING_BUDGET=512
# Retry transient Gemini 503/429 failures per model tier with exponential backoff
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY=2.0

# ── Reranker ──
USE_RERANKER=True
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Session Management ──
SESSION_PERSIST=True                       # persist chat sessions to disk (survives restart)
SESSION_PERSIST_DIR=./data/sessions
SESSION_MAX_TURNS=6                        # compact older turns when conversation exceeds this many user turns
SESSION_KEEP_RECENT=3                      # keep last N turns verbatim after compaction
SESSION_TTL_HOURS=168                      # 7 days; idle sessions older than this are pruned

# ── Ingest Automation ──
INGEST_INBOX_DIR=./data/inbox              # drop new legal docs here for the watch-folder ingester
INGEST_WATCH_INTERVAL_S=30                 # scripts/watch_ingest.py polls every N seconds

# ── Benchmark (compare our system vs. OpenAI/Claude via OpenRouter) ──
BENCHMARK_OPENAI_MODEL=openai/gpt-4o-mini
BENCHMARK_CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# ── Data Paths ──
DATASET_DIR=./data/legal_docs
DATA_DIR=./data

# ── Server ──
HOST=0.0.0.0
PORT=8000
